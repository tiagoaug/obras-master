-- lancamentoId/centroDeCustoId sem FK: LancamentoFinanceiro/CentroDeCusto migraram pro Firestore
-- na Fase 10 (pivô Firebase); RateioLancamento continua local por enquanto — fora do escopo desta migração.
CREATE TABLE RateioLancamento (
    id TEXT NOT NULL PRIMARY KEY,
    lancamentoId TEXT NOT NULL,
    centroDeCustoId TEXT NOT NULL,
    percentual REAL NOT NULL
);

selectDoLancamento:
SELECT * FROM RateioLancamento WHERE lancamentoId = ?;

insert:
INSERT INTO RateioLancamento(id, lancamentoId, centroDeCustoId, percentual)
VALUES (?, ?, ?, ?);

deleteDoLancamento:
DELETE FROM RateioLancamento WHERE lancamentoId = ?;
