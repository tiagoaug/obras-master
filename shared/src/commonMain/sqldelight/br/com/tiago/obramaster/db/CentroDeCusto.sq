CREATE TABLE CentroDeCusto (
    id TEXT NOT NULL PRIMARY KEY,
    nome TEXT NOT NULL,
    tipo TEXT NOT NULL,
    projetoId TEXT,
    ativo INTEGER AS kotlin.Boolean NOT NULL DEFAULT 1,
    FOREIGN KEY (projetoId) REFERENCES Projeto(id)
);

selectAtivos:
SELECT * FROM CentroDeCusto WHERE ativo = 1 ORDER BY nome;

selectPorProjetoId:
SELECT * FROM CentroDeCusto WHERE projetoId = ? AND ativo = 1 LIMIT 1;

insert:
INSERT INTO CentroDeCusto(id, nome, tipo, projetoId, ativo)
VALUES (?, ?, ?, ?, ?);

update:
UPDATE CentroDeCusto SET nome = ?, tipo = ? WHERE id = ?;

softDelete:
UPDATE CentroDeCusto SET ativo = 0 WHERE id = ?;
