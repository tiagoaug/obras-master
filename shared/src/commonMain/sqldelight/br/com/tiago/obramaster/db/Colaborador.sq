CREATE TABLE Colaborador (
    id TEXT NOT NULL PRIMARY KEY,
    nome TEXT NOT NULL,
    login TEXT NOT NULL UNIQUE,
    senhaHash TEXT NOT NULL,
    salt TEXT NOT NULL,
    ativo INTEGER AS kotlin.Boolean NOT NULL DEFAULT 1,
    ehGestor INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0
);

selectAtivos:
SELECT * FROM Colaborador WHERE ativo = 1;

selectById:
SELECT * FROM Colaborador WHERE id = ? AND ativo = 1;

selectByLogin:
SELECT * FROM Colaborador WHERE login = ? AND ativo = 1;

countAtivos:
SELECT COUNT(*) FROM Colaborador WHERE ativo = 1;

insert:
INSERT INTO Colaborador(id, nome, login, senhaHash, salt, ativo, ehGestor)
VALUES (?, ?, ?, ?, ?, ?, ?);

update:
UPDATE Colaborador SET nome = ?, login = ?, ehGestor = ? WHERE id = ?;

updateSenha:
UPDATE Colaborador SET senhaHash = ?, salt = ? WHERE id = ?;

softDelete:
UPDATE Colaborador SET ativo = 0 WHERE id = ?;
