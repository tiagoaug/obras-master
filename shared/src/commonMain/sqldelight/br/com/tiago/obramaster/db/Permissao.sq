CREATE TABLE Permissao (
    colaboradorId TEXT NOT NULL,
    moduleId TEXT NOT NULL,
    nivel TEXT NOT NULL,
    PRIMARY KEY (colaboradorId, moduleId),
    FOREIGN KEY (colaboradorId) REFERENCES Colaborador(id)
);

selectByColaborador:
SELECT * FROM Permissao WHERE colaboradorId = ?;

selectAll:
SELECT * FROM Permissao;

upsert:
INSERT OR REPLACE INTO Permissao(colaboradorId, moduleId, nivel)
VALUES (?, ?, ?);

deleteByColaborador:
DELETE FROM Permissao WHERE colaboradorId = ?;
