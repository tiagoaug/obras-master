CREATE TABLE UnidadeMedida (
    id TEXT NOT NULL PRIMARY KEY,
    sigla TEXT NOT NULL,
    nome TEXT NOT NULL,
    ativo INTEGER AS kotlin.Boolean NOT NULL DEFAULT 1
);

selectAtivas:
SELECT * FROM UnidadeMedida WHERE ativo = 1 ORDER BY nome;

insert:
INSERT INTO UnidadeMedida(id, sigla, nome, ativo) VALUES (?, ?, ?, ?);

update:
UPDATE UnidadeMedida SET sigla = ?, nome = ? WHERE id = ?;

softDelete:
UPDATE UnidadeMedida SET ativo = 0 WHERE id = ?;
