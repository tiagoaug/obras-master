CREATE TABLE Meta (
    id TEXT NOT NULL PRIMARY KEY,
    escopo TEXT NOT NULL,
    referenciaId TEXT,
    titulo TEXT NOT NULL,
    tipo TEXT NOT NULL,
    valorAlvo INTEGER NOT NULL,
    prazo INTEGER,
    concluida INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    ativo INTEGER AS kotlin.Boolean NOT NULL DEFAULT 1
);

selectAtivas:
SELECT * FROM Meta WHERE ativo = 1 ORDER BY concluida, prazo IS NULL, prazo;

insert:
INSERT INTO Meta(id, escopo, referenciaId, titulo, tipo, valorAlvo, prazo, concluida, ativo)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

update:
UPDATE Meta SET titulo = ?, valorAlvo = ?, prazo = ?, concluida = ?
WHERE id = ?;

softDelete:
UPDATE Meta SET ativo = 0 WHERE id = ?;
