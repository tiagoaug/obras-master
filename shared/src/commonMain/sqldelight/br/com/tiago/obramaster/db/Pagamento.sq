CREATE TABLE Pagamento (
    id TEXT NOT NULL PRIMARY KEY,
    pessoaId TEXT NOT NULL,
    projetoId TEXT,
    periodo TEXT NOT NULL,
    valorTotal INTEGER NOT NULL,
    dataPagamento INTEGER NOT NULL,
    status TEXT NOT NULL,
    comprovanteUri TEXT,
    lancamentoFinanceiroId TEXT,
    FOREIGN KEY (pessoaId) REFERENCES Pessoa(id),
    FOREIGN KEY (projetoId) REFERENCES Projeto(id)
);

selectTodos:
SELECT * FROM Pagamento ORDER BY dataPagamento DESC;

selectDaPessoa:
SELECT * FROM Pagamento WHERE pessoaId = ? ORDER BY dataPagamento DESC;

insert:
INSERT INTO Pagamento(id, pessoaId, projetoId, periodo, valorTotal, dataPagamento, status, comprovanteUri, lancamentoFinanceiroId)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);
