CREATE TABLE Pessoa (
    id TEXT NOT NULL PRIMARY KEY,
    nome TEXT NOT NULL,
    telefone TEXT,
    email TEXT,
    endereco TEXT,
    documento TEXT,
    fotoUri TEXT,
    observacoes TEXT,
    ativo INTEGER AS kotlin.Boolean NOT NULL DEFAULT 1
);

CREATE TABLE PessoaTag (
    pessoaId TEXT NOT NULL,
    tag TEXT NOT NULL,
    PRIMARY KEY (pessoaId, tag),
    FOREIGN KEY (pessoaId) REFERENCES Pessoa(id)
);

selectAtivas:
SELECT * FROM Pessoa WHERE ativo = 1 ORDER BY nome;

selectTagsDe:
SELECT tag FROM PessoaTag WHERE pessoaId = ?;

selectTodasTags:
SELECT * FROM PessoaTag;

insertPessoa:
INSERT INTO Pessoa(id, nome, telefone, email, endereco, documento, fotoUri, observacoes, ativo)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

updatePessoa:
UPDATE Pessoa SET nome = ?, telefone = ?, email = ?, endereco = ?, documento = ?, fotoUri = ?, observacoes = ?
WHERE id = ?;

softDeletePessoa:
UPDATE Pessoa SET ativo = 0 WHERE id = ?;

insertTag:
INSERT OR IGNORE INTO PessoaTag(pessoaId, tag) VALUES (?, ?);

deleteTagsDe:
DELETE FROM PessoaTag WHERE pessoaId = ?;
