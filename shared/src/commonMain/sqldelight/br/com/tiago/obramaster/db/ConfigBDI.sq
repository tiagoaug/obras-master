CREATE TABLE ConfigBDI (
    id TEXT NOT NULL PRIMARY KEY,
    nome TEXT NOT NULL,
    administracaoCentral REAL NOT NULL,
    seguroGarantia REAL NOT NULL,
    riscos REAL NOT NULL,
    despesasFinanceiras REAL NOT NULL,
    lucro REAL NOT NULL,
    tributos REAL NOT NULL,
    padrao INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    ativo INTEGER AS kotlin.Boolean NOT NULL DEFAULT 1
);

selectAtivos:
SELECT * FROM ConfigBDI WHERE ativo = 1 ORDER BY nome;

insert:
INSERT INTO ConfigBDI(id, nome, administracaoCentral, seguroGarantia, riscos, despesasFinanceiras, lucro, tributos, padrao, ativo)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

update:
UPDATE ConfigBDI SET nome = ?, administracaoCentral = ?, seguroGarantia = ?, riscos = ?, despesasFinanceiras = ?, lucro = ?, tributos = ?, padrao = ?
WHERE id = ?;

softDelete:
UPDATE ConfigBDI SET ativo = 0 WHERE id = ?;

limparPadrao:
UPDATE ConfigBDI SET padrao = 0 WHERE id != ?;
